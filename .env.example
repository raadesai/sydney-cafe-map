# Copy this file to .env.local and fill in your own values.
# .env.local is gitignored — never commit real keys.

# ── Supabase (Project Settings → API) ──────────────────────────────────────
# URL + publishable/anon key are safe in the browser (RLS limits them to reads).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Secret key bypasses RLS — server-side only, used by the API routes. Keep private.
SUPABASE_SECRET_KEY=your-supabase-secret-key

# ── MapTiler (cloud.maptiler.com → API keys) ───────────────────────────────
# Used for the base map tiles and geocoding when adding a place.
NEXT_PUBLIC_MAPTILER_KEY=your-maptiler-key

# ── Edit password ──────────────────────────────────────────────────────────
# The shared password that unlocks editing / photos. Pick anything unguessable;
# the app checks entered passwords against this value server-side.
ADD_PLACE_SECRET=choose-a-strong-password

# ── Vercel Blob (for place photos) ─────────────────────────────────────────
# Create a Blob store in your Vercel project; this token comes with it.
BLOB_READ_WRITE_TOKEN=your-vercel-blob-rw-token

# ── Web Push (VAPID) ───────────────────────────────────────────────────────
# Generate a keypair once with:  npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
